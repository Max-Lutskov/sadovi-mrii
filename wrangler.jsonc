// Cloudflare Worker: пререндерені сторінки й фото віддаються як статичні файли, Worker обробляє лише /api/lead.
// Деплой: npm run deploy (збирає з пресетом cloudflare_module і викликає wrangler deploy)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sadovi-mrii",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2025-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  // Сайт живе лише на своєму домені: адреса workers.dev вимкнена, щоб Google не бачив другу копію
  "routes": [{ "pattern": "sadovi-mrii.com.ua", "custom_domain": true }],
  "workers_dev": false,
  "observability": { "enabled": true }
}
